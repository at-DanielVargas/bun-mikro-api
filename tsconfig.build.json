{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist/esm",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src/**/*"],
  "exclude": [
    "tests/**/*",
    "dist/**/*",
    "node_modules/**/*",
    "src/migrate.ts",
    "src/migrations/**/*",
    "src/database/D1WranglerDriver.ts"
  ]
}
